#!/usr/bin/env bash
# save-current-track — Universal audio identifier, recorder & metadata saver
# Works on any Arch / Linux system with PipeWire / PulseAudio.
# Dependencies: ffmpeg, songrec, playerctl, jq, libnotify, wl-clipboard (or xclip)

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
captures_dir="${MUSIC_DIR:-$HOME/Music}/radio_captures"
log_file="${MUSIC_DIR:-$HOME/Music}/radio_gems.txt"

mkdir -p "$(dirname "$log_file")" "$captures_dir"

# Clipboard helper (Wayland / X11 fallback)
copy_to_clipboard() {
    local text="$1"
    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$text" | wl-copy 2>/dev/null || true
    elif command -v xclip >/dev/null 2>&1; then
        printf '%s' "$text" | xclip -selection clipboard 2>/dev/null || true
    fi
}

# Clean string helper for filenames
sanitize_filename() {
    local raw="$1"
    echo "$raw" | tr '/\\:*?"<>|' '_' | sed -e 's/  */ /g' -e 's/^[[:space:]_]*//' -e 's/[[:space:]_]*$//'
}

# Parse "Artist - Title" or "Artist — Title" from single string
parse_artist_title() {
    local raw="$1"
    local artist=""
    local title=""

    if [[ "$raw" == *" — "* ]]; then
        artist="${raw%% — *}"
        title="${raw#* — }"
    elif [[ "$raw" == *" – "* ]]; then
        artist="${raw%% – *}"
        title="${raw#* – }"
    elif [[ "$raw" == *" - "* ]]; then
        artist="${raw%% - *}"
        title="${raw#* - }"
    fi

    artist=$(echo "$artist" | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//")
    title=$(echo "$title" | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//")

    if [[ -n "$artist" && -n "$title" ]]; then
        echo "${artist} — ${title}"
    else
        echo "$raw"
    fi
}

track=""
source_label=""
stream_url=""
source_tag="Desktop"
has_exact_metadata=false

# 1. Discover generic radio / web stream status (if present in runtime directory)
radio_status=$(find "$runtime_dir" -maxdepth 2 -name "status.json" 2>/dev/null | head -n 1 || true)
if [[ -n "$radio_status" && -f "$radio_status" ]]; then
    is_running=$(jq -r '.running // false' "$radio_status" 2>/dev/null || true)
    is_paused=$(jq -r '.paused // false' "$radio_status" 2>/dev/null || true)
    title=$(jq -r '.title // empty' "$radio_status" 2>/dev/null || true)
    station_name=$(jq -r '.station.name // empty' "$radio_status" 2>/dev/null || true)

    if [[ "$is_running" == "true" && "$is_paused" != "true" && -n "$title" ]]; then
        track="$title"
        source_label="Радио: ${station_name:-Интернет-радио}"
        source_tag="${station_name:-Radio}"

        # Check for generic mpv IPC socket to grab direct digital stream
        mpv_sock=$(find "$runtime_dir" -maxdepth 2 -name "*mpv*.sock" 2>/dev/null | head -n 1 || true)
        if [[ -n "$mpv_sock" && -S "$mpv_sock" ]] && command -v socat >/dev/null 2>&1; then
            stream_url=$(echo '{ "command": ["get_property", "path"] }' | socat - "$mpv_sock" 2>/dev/null | jq -r '.data // empty' || true)
        fi
    fi
fi

# 2. Check standard MPRIS players (Spotify, Firefox, Chromium, MPV, VLC, Telegram, etc.)
if [[ -z "$track" ]] && command -v playerctl >/dev/null 2>&1; then
    player_name=$(playerctl metadata --format '{{ playerName }}' 2>/dev/null || true)

    if [[ -n "$player_name" ]]; then
        artist=$(playerctl metadata --format '{{ artist }}' 2>/dev/null || true)
        title=$(playerctl metadata --format '{{ title }}' 2>/dev/null || true)

        # Ignore generic video/browser channel placeholders
        if [[ -n "$title" && -n "$artist" && "$artist" != "$title" ]]; then
            track="${artist} — ${title}"
            has_exact_metadata=true
        elif [[ -n "$title" ]]; then
            track=$(parse_artist_title "$title")
            if [[ "$track" == *" — "* ]]; then
                has_exact_metadata=true
            fi
        fi

        source_label="Плеер: ${player_name}"
        source_tag="${player_name}"
    fi
fi

# 3. Fallback: generic system desktop audio
if [[ -z "$track" ]]; then
    source_label="Система: Рабочий стол"
    source_tag="Desktop"
    track="Аудиопоток"
fi

# Copy immediate known title to clipboard
if [[ "$track" != "Аудиопоток" ]]; then
    copy_to_clipboard "$track"
fi

# Function to record audio snippet and identify via Shazam API (SongRec)
run_record_and_shazam() {
    local source_name="$1"
    local raw_track="$2"
    local source_display="$3"
    local direct_url="$4"
    local is_exact="$5"

    local ts
    ts=$(date '+%Y-%m-%d_%H-%M-%S')

    local safe_source
    safe_source=$(echo "$source_name" | tr -cs 'a-zA-Z0-9_-' '_' | sed 's/^_//;s/_$//')
    safe_source="${safe_source:-Audio}"

    local temp_file="$captures_dir/${ts}_[${safe_source}]_recording.mp3"

    # Step 1: Capture 15-second audio sample
    # Direct stream URL if available, otherwise default sink monitor (headphones/speakers)
    if [[ -n "$direct_url" ]]; then
        ffmpeg -y -t 15 -i "$direct_url" -c:a libmp3lame -b:a 192k "$temp_file" >/dev/null 2>&1 || true
    fi

    if [[ ! -s "$temp_file" ]]; then
        ffmpeg -y -t 15 -f pulse -i "@DEFAULT_SINK@.monitor" -c:a libmp3lame -b:a 192k "$temp_file" >/dev/null 2>&1 || true
    fi

    if [[ ! -s "$temp_file" ]]; then
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u low -i dialog-warning "Запись звука" "Не удалось записать аудиопоток"
        fi
        rm -f "$temp_file"
        return 1
    fi

    # Detect complete silence (< -65 dB) to avoid saving empty noise
    local max_vol
    max_vol=$(ffmpeg -i "$temp_file" -af volumedetect -f null /dev/null 2>&1 | grep -i "max_volume:" | awk '{print $5}' || true)
    if [[ "$max_vol" == "-inf" || $(awk "BEGIN {print ($max_vol < -65.0)}") -eq 1 ]] 2>/dev/null; then
        rm -f "$temp_file"
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u low -i audio-volume-muted "Музыка" "В системе сейчас тишина — запись отменена"
        fi
        return 0
    fi

    # Step 2: Query Shazam API via SongRec
    local shazam_json=""
    if command -v songrec >/dev/null 2>&1; then
        shazam_json=$(songrec audio-file-to-recognized-song "$temp_file" 2>/dev/null || true)
    fi

    local shazam_artist=""
    local shazam_title=""
    if [[ -n "$shazam_json" ]]; then
        shazam_artist=$(jq -r '.track.subtitle // empty' <<< "$shazam_json" 2>/dev/null || true)
        shazam_title=$(jq -r '.track.title // empty' <<< "$shazam_json" 2>/dev/null || true)
    fi

    local cur_time
    cur_time=$(date '+%Y-%m-%d %H:%M')

    # Case A: Shazam found a match
    if [[ -n "$shazam_title" ]]; then
        local recognized="${shazam_artist} — ${shazam_title}"
        local safe_title
        safe_title=$(sanitize_filename "$recognized")
        local final_file="$captures_dir/${ts}_[${safe_source}]_${safe_title}.mp3"

        mv "$temp_file" "$final_file"

        # Update clipboard with recognized track
        copy_to_clipboard "$recognized"

        # Log recognized track
        echo "[$cur_time] [${source_display}] 🔍 Shazam: $recognized (Источник: $raw_track) -> $(basename "$final_file")" >> "$log_file"

        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u normal -i audio-x-generic "🎵 Shazam: найден трек!" "$recognized\nСкопировано в буфер | $(basename "$final_file")"
        fi

    # Case B: Shazam has no match, BUT we have exact/parsed metadata from player or stream
    elif [[ "$raw_track" != "Аудиопоток" && -n "$raw_track" ]]; then
        local safe_known
        safe_known=$(sanitize_filename "$raw_track")
        local final_file="$captures_dir/${ts}_[${safe_source}]_${safe_known}.mp3"

        mv "$temp_file" "$final_file"
        copy_to_clipboard "$raw_track"

        if [[ "$is_exact" == "true" ]]; then
            echo "[$cur_time] [${source_display}] $raw_track -> $(basename "$final_file")" >> "$log_file"
            if command -v notify-send >/dev/null 2>&1; then
                notify-send -u normal -i audio-x-generic "🎵 Трек сохранён!" "$raw_track\nСкопировано в буфер | $(basename "$final_file")"
            fi
        else
            echo "[$cur_time] [${source_display}] $raw_track -> $(basename "$final_file") (Shazam: без совпадений)" >> "$log_file"
            if command -v notify-send >/dev/null 2>&1; then
                notify-send -u low -i audio-speakers "💾 Сэмпл сохранён" "$raw_track\nФайл: $(basename "$final_file") (в Shazam нет)"
            fi
        fi

    # Case C: Pure anonymous desktop audio without metadata and no Shazam match
    else
        local final_file="$captures_dir/${ts}_[${safe_source}]_unmatched.mp3"
        mv "$temp_file" "$final_file"

        echo "[$cur_time] [${source_display}] Неизвестный трек -> $(basename "$final_file") (Shazam: без совпадений)" >> "$log_file"

        if command -v notify-send >/dev/null 2>&1; then
            notify-send -u low -i audio-speakers "💾 Сэмпл сохранён" "Неизвестный трек\nФайл: $(basename "$final_file") (в Shazam нет)"
        fi
    fi
}

# Immediate feedback notification
if command -v notify-send >/dev/null 2>&1; then
    notify-send -u normal -i audio-x-generic "$source_label" "$track\nСохраняю и проверяю через Shazam..."
fi

# Run background recording & recognition
run_record_and_shazam "$source_tag" "$track" "$source_label" "$stream_url" "$has_exact_metadata" </dev/null >/dev/null 2>&1 &
disown
